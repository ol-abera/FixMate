# Copy to .env and fill in real values. NEVER commit .env.
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_NAME=fixmate
DATABASE_USER=fixmate
DATABASE_PASSWORD=replace-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Comma-separated. The Vite dev server in this repo runs on 3000; 5173 is Vite's default.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional
# MEDIA_ROOT=/var/lib/fixmate/media
# SECURE_SSL_REDIRECT=True        # set in production behind HTTPS
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=7

# Email (password reset). Without these, emails are printed to the runserver console.
# FRONTEND_URL=http://localhost:3000
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=FixMate <no-reply@example.com>

# Payments. Without a Stripe key, DEBUG setups get a local mock checkout (PAYMENTS_MOCK=False disables it).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen --forward-to localhost:8000/api/payments/webhook/`
# PAYMENTS_CURRENCY=usd
# PAYMENTS_MOCK=True

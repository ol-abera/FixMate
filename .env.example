VITE_API_URL=http://localhost:8000/api
# Optional: shown on the Help page contact section
# VITE_SUPPORT_EMAIL=support@example.com
# Optional: WebSocket endpoint. Defaults to the API host with /api replaced by /ws/.
# VITE_WS_URL=ws://localhost:8000/ws/

# --- docker compose (docker-compose.yml reads this file) ---
# SECRET_KEY=replace-with-a-long-random-string
# DATABASE_PASSWORD=replace-me
# APP_URL=http://localhost:8080      # public URL of the app; used for CORS/CSRF, reset links and Stripe redirects
# APP_PORT=8080
# SEED_DEMO=1                        # load demo data on start (throwaway demos only)
# SEED_PASSWORD=choose-a-demo-password
# PAYMENTS_MOCK=True                 # test-mode checkout without Stripe (demos only)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
